<Window x:Class="RobloxMacro.App.TestTargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controlled Win32 Target Window (Roblox Focus-Gate Simulator)"
        Width="520" Height="420"
        Background="#0F172A"
        Foreground="#F8FAFC"
        WindowStartupLocation="Manual"
        Left="80" Top="80">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="12" BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Controlled Win32 &amp; Game-Engine Focus Gate Target"
                           FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"
                           Text="Select this window in the Macro App to observe the difference between raw Win32 WM_LBUTTONDOWN delivery (works Focused, Unfocused, and Minimized) vs. Roblox's Focus-Gated UserInputService (only registers attacks when Focused &amp; Restored)."/>
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,10,0,10">
            <Border Background="#1E293B" CornerRadius="8" Padding="10" Margin="0,0,6,0" BorderBrush="#0EA5E9" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="RAW WIN32 WndProc CLICKS" FontSize="11" FontWeight="SemiBold" Foreground="#7DD3FC"/>
                    <TextBlock x:Name="RawClickCountText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                    <TextBlock Text="Counts even when Unfocused or Minimized" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>

            <Border Background="#1E293B" CornerRadius="8" Padding="10" Margin="6,0,0,0" BorderBrush="#10B981" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ROBLOX-STYLE FOCUS-GATED ATTACKS" FontSize="11" FontWeight="SemiBold" Foreground="#6EE7B7"/>
                    <TextBlock x:Name="FocusGatedClickCountText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                    <TextBlock Text="Requires WindowFocused == true &amp; Restored" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="#020617" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" ClipToBounds="True">
            <Canvas x:Name="HitCanvas">
                <TextBlock Canvas.Left="12" Canvas.Top="10"
                           x:Name="WindowStateOverlayText"
                           Text="Window State: Ready — Waiting for Clicks..."
                           FontSize="12" Foreground="#94A3B8"/>
                <Ellipse x:Name="HitMarker" Width="18" Height="18"
                         Stroke="#F43F5E" StrokeThickness="2.5" Fill="#44F43F5E"
                         Visibility="Collapsed"/>
            </Canvas>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="LastEventText" VerticalAlignment="Center" Foreground="#CBD5E1" FontSize="12"
                       Text="Last Click: None"/>
            <Button Content="Reset Counters" HorizontalAlignment="Right" Padding="12,5"
                    Background="#334155" Foreground="White" BorderThickness="0"
                    Click="ResetCounters_Click"/>
        </DockPanel>
    </Grid>
</Window>
